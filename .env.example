# ============================================================================
# WarrenIA — environment variables (NO secrets in this file).
# Web (Vercel → Project → Settings → Environment Variables, or web/.env.local)
# Engine (GitHub → repo → Settings → Secrets and variables → Actions)
# ============================================================================

# ---------------------------------------------------------------- Web (Vercel)
# Supabase project (Settings → API). Publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: SERVER ONLY (reads the private `market` bucket). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_BUCKET=market
# Comma-separated e-mails allowed to sign in. Empty = nobody (fail closed).
ALLOWED_EMAILS=tu-email@ejemplo.com
# Public URL of the deployment (magic-link redirects). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=https://warrenia.vercel.app

# Local development only (never on Vercel): run without Supabase/login,
# reading engine output from ../data and storing your portfolio in web/.data/.
# WARRENIA_LOCAL_MODE=1
# WARRENIA_DATA_DIR=../data
# WARRENIA_LOCAL_STORE=./.data/user.json

# ------------------------------------------------- Engine (GitHub Actions secrets)
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx        (same secret key as above)
# MASSIVE_API_KEY=xxx                             (massive.com, free Basic plan)
# SEC_USER_AGENT="WarrenIA tu-email@ejemplo.com"  (SEC fair-access policy)
# EODHD_API_KEY=xxx                               (optional, EUR prices of your ETFs)
# Optional repository variables:
# MASSIVE_MIN_INTERVAL=12.5   (seconds between calls; free plan = 5/min)
# SUPABASE_BUCKET=market
